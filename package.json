{
  "name": "@scayle/storefront-application-v3",
  "version": "3.0.0",
  "release-date": "2026-11-23",
  "description": "The third iteration of the SCAYLE Storefront Application based on Hono and Inertia.js",
  "scayle": {
    "framework": "storefront-v3"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scayle/storefront-application.git"
  },
  "homepage": "https://github.com/scayle/storefront-application#readme",
  "bugs": {
    "url": "https://github.com/scayle/storefront-application/discussions"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^26",
    "pnpm": ">=12.23.0"
  },
  "scripts": {
    "dev": "vite dev",
    "preview": "node --env-file=.env .output/server/index.mjs",
    "start": "node .output/server/index.mjs",
    "build": "pnpm build:ssr && pnpm build:client",
    "build:client": "rm -rf .output/public && vite build",
    "build:ssr": "rm -rf .output/server && vite build --ssr",
    "format:fix": "NODE_OPTIONS='--experimental-strip-types' PRETTIER_EXPERIMENTAL_CLI=1 prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-unknown --log-level warn --parallel-workers 2 --write .",
    "format": "NODE_OPTIONS='--experimental-strip-types' PRETTIER_EXPERIMENTAL_CLI=1 prettier --ignore-path .gitignore --ignore-path .prettierignore --ignore-unknown --log-level warn --parallel-workers 2 --check .",
    "lint:fix": "eslint --fix",
    "lint": "eslint",
    "lint:fast": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "storybook:build": "rm -rf storybook-static && storybook build",
    "storybook": "storybook dev -p 6006",
    "cms:sync": "bash ./scripts/sync-cms.sh",
    "cms:import": "bash ./scripts/import-cms.sh",
    "typecheck": "vue-tsc --noEmit && pnpm typecheck:cms-providers",
    "typecheck:cms-providers": "vue-tsc --noEmit -p tsconfig.storyblok.json && vue-tsc --noEmit -p tsconfig.contentful.json && vue-tsc --noEmit -p tsconfig.contentstack.json && vue-tsc --noEmit -p tsconfig.amplience.json",
    "test": "vitest run",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=junit --outputFile=./coverage/junit.xml"
  },
  "dependencies": {
    "@contentful/live-preview": "4.10.28",
    "@contentful/rich-text-html-renderer": "17.2.3",
    "@contentful/rich-text-types": "17.2.7",
    "@contentstack/live-preview-utils": "4.6.1",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.8",
    "@inertiajs/core": "3.11.0",
    "@inertiajs/vue3": "3.11.0",
    "@orpc/client": "1.16.2",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/zod": "1.16.2",
    "@regle/core": "1.29.5",
    "@regle/rules": "1.29.5",
    "@scayle/storefront-opentelemetry": "1.0.0",
    "@scayle/storefront": "1.0.0",
    "@scayle/storefront-api": "19.9.2",
    "@scayle/storefront-cms-amplience": "1.0.0",
    "@scayle/storefront-cms-contentful": "1.0.0",
    "@scayle/storefront-cms-contentstack": "1.0.0",
    "@scayle/storefront-cms-storyblok": "1.0.0",
    "@vue/server-renderer": "3.5.46",
    "@vueuse/core": "15.0.0",
    "@vueuse/gesture": "2.0.0",
    "hono": "4.13.19",
    "isomorphic-dompurify": "4.7.0",
    "jose": "6.2.17",
    "marked": "18.2.1",
    "undici": "8.12.4",
    "unstorage": "1.17.6",
    "vue": "3.5.46",
    "vue-i18n": "11.4.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@amplience/dc-cli": "0.31.0",
    "@apidevtools/json-schema-ref-parser": "16.0.8",
    "@changesets/cli": "2.31.1",
    "@contentstack/cli": "2.0.2",
    "@hono/vite-dev-server": "0.26.1",
    "@scayle/changelog-formatter": "1.2.0",
    "@scayle/checkout-types": "2.1.73",
    "@scayle/eslint-config-storefront": "5.5.2",
    "@scayle/prettier-config-storefront": "2.1.0",
    "@scayle/storefront-build": "1.0.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/vue3-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.6.0",
    "@storyblok/js": "6.5.0",
    "@timbenniks/contentstack-endpoints": "3.0.2",
    "@contentstack/delivery-sdk": "5.6.2",
    "cf-content-types-generator": "3.0.1",
    "contentful": "11.12.10",
    "contentful-cli": "4.0.14",
    "contentful-resolve-response": "2.0.1",
    "dc-delivery-sdk-js": "1.4.0",
    "dc-visualization-sdk": "1.1.0",
    "eslint": "10.15.0",
    "eslint-formatter-gitlab": "7.2.0",
    "eslint-plugin-import-x": "4.18.1",
    "happy-dom": "21.0.4",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rolldown": "1.3.2",
    "schema-dts": "2.1.0",
    "storyblok": "4.20.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "type-fest": "^5.9.0",
    "@scayle/storefront-devtools": "1.0.0",
    "vite": "8.3.8",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
