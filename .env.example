### SHOP ###
# Tenant space, as it appears in the SCAYLE Panel URL (e.g. `<tenant-space>.panel.scayle.cloud`).
STOREFRONT_TENANT_SPACE=
# Parent shop key (SCAYLE Panel > Shops).
STOREFRONT_SHOP_KEY=
STOREFRONT_API_KEY=
STOREFRONT_SESSION_SECRET=
STOREFRONT_OAUTH_CLIENT_ID=
STOREFRONT_OAUTH_CLIENT_SECRET=

### COUNTRIES ###

# Country: DE
STOREFRONT_COUNTRIES_DE_SHOP_COUNTRY_ID=
STOREFRONT_COUNTRIES_DE_CHECKOUT_USER=
STOREFRONT_COUNTRIES_DE_CHECKOUT_TOKEN=
STOREFRONT_COUNTRIES_DE_CHECKOUT_SECRET=

# Country: US
STOREFRONT_COUNTRIES_US_SHOP_COUNTRY_ID=
STOREFRONT_COUNTRIES_US_CHECKOUT_USER=
STOREFRONT_COUNTRIES_US_CHECKOUT_TOKEN=
STOREFRONT_COUNTRIES_US_CHECKOUT_SECRET=

# Country: AT
STOREFRONT_COUNTRIES_AT_SHOP_COUNTRY_ID=
STOREFRONT_COUNTRIES_AT_CHECKOUT_USER=
STOREFRONT_COUNTRIES_AT_CHECKOUT_TOKEN=
STOREFRONT_COUNTRIES_AT_CHECKOUT_SECRET=

### ROUTING ###
# Public-facing host of the deployed storefront (no scheme, no trailing slash).
# Pins the origin of every absolute URL the storefront emits: canonical links,
# hreflang alternates, JSON-LD, `og:url`, and the shop switcher. Set it in
# production when the proxy does not forward the public host via
# `x-forwarded-host`. Optional: unset, the origin is derived from the
# forwarded host of the incoming request. Leave it empty locally, and in
# domain mode, where the origin comes from the country's own domain.
STOREFRONT_DOMAIN=
# Routing mode for country resolution. `path` prefixes every country (`/de`,
# `/en`); `path_except_default` omits the prefix for the default country.
# Defaults to `path` when unset.
STOREFRONT_COUNTRY_SELECTOR=path

### CMS ###
# Build-time (Vite aliases) and runtime (server factory).
# scayle | storyblok | contentful | contentstack | amplience
CMS_PROVIDER=scayle
# Draft content in CMS editor preview (e.g. Storyblok `_storyblok`).
STOREFRONT_CMS_ALLOW_DRAFTS=false

### CMS: Storyblok ###
# Preview or Public token (Space → Settings → Access tokens).
STORYBLOK_CMS_ACCESS_TOKEN=
# Used for sync-cms.sh script
STORYBLOK_CMS_SPACE=
STORYBLOK_CMS_PERSONAL_TOKEN=
STORYBLOK_CMS_REGION=eu

### CMS: Contentful ###
# Content Delivery API access token.
CONTENTFUL_CMS_ACCESS_TOKEN=
CONTENTFUL_CMS_SPACE=
CONTENTFUL_CMS_PREVIEW_ACCESS_TOKEN=
# Used for sync-cms.sh script
CONTENTFUL_CMS_MANAGEMENT_TOKEN=

### CMS: Contentstack ###
# Delivery token (pair with CONTENTSTACK_CMS_STACK_API_KEY).
CONTENTSTACK_CMS_DELIVERY_TOKEN=
CONTENTSTACK_CMS_PREVIEW_ACCESS_TOKEN=
CONTENTSTACK_CMS_STACK_API_KEY=
CONTENTSTACK_CMS_ENVIRONMENT=production
# One of: na, eu, au, azure-na, azure-eu, gcp-na, gcp-eu
# The aliases us, aws-na, aws-eu, and aws-au are also accepted.
# An unrecognized value throws when the CMS service is first created (the first request
# that needs CMS content), instead of silently serving na content.
CONTENTSTACK_CMS_REGION=na
# Used for sync-cms.sh script
CONTENTSTACK_CMS_MANAGEMENT_TOKEN=
CONTENTSTACK_CMS_BRANCH=main

### CMS: Amplience ###
# Content Delivery 2 hub name, used as the delivery subdomain.
AMPLIENCE_CMS_HUB_NAME=
# Used by the Amplience content-model tooling. The hub ID from hub settings, not the hub name.
AMPLIENCE_CMS_HUB_ID=
AMPLIENCE_CMS_PERSONAL_ACCESS_TOKEN=

### CACHING ###
# SCAYLE KV runs in cluster mode. Set to `true` to connect to a single Redis or
# Valkey instance instead, such as the one from `docker-compose.yml`.
STOREFRONT_KV_DISABLE_CLUSTER_MODE=true
STOREFRONT_CACHE_COMPRESSION=none
STOREFRONT_CACHE_DISABLED=true

### LOGGING ###
# tslog output shape. `pretty` for readable lines, otherwise `json` (default).
STOREFRONT_LOG_FORMAT=pretty
# Minimum log level. One of: debug, info, warn, error. Defaults to `info` when unset.
STOREFRONT_LOG_LEVEL=info
# Comma-separated extra keys to redact in log payloads. Merged with the built-in denylist.
STOREFRONT_LOG_REDACT_KEYS=

### OBSERVABILITY ###
# Standard OpenTelemetry SDK env vars, read by the NodeSDK at startup.
# For local traces: `docker compose --profile tracing up -d` starts Jaeger, then set
# OTEL_EXPORTER_OTLP_ENDPOINT to http://localhost:4318 and OTEL_METRICS_EXPORTER to none.
# See docs/observability.md for reading the traces it collects.
OTEL_SERVICE_NAME='storefront'
# Comma-separated key=value pairs, e.g. `deployment.environment=production,service.version=1.0.0`.
OTEL_RESOURCE_ATTRIBUTES=
# OTLP collector endpoint. The local Jaeger from `docker-compose.yml` listens on `http://localhost:4318`.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated headers for OTLP requests (e.g. `api-key=secret`).
OTEL_EXPORTER_OTLP_HEADERS=
# Trace sampler argument (e.g. `0.1` for 10% sampling).
OTEL_TRACES_SAMPLER_ARG=
# Trace exporter selection. NodeSDK: otlp (default), console, none.
# Set to `console` to see spans in the dev server output without a collector.
# OTEL_TRACES_EXPORTER=console
# Metric exporter selection. NodeSDK: otlp (default), console, none.
# Set to `none` when exporting to the local Jaeger, which receives traces only and answers
# 404 on /v1/metrics, so the default setting exports a batch every interval that is rejected.
# OTEL_METRICS_EXPORTER=none
# Wraps cache compression/decompression in OTEL spans. Read at runtime on every call, and only `true`, in any letter case, turns it on.
UNSTORAGE_COMPRESSION_OTEL_TRACE=false

### CONSENT MANAGEMENT ###
# Needed for every country with consentManagementRequired (DE, AT and US
# by default). While empty those countries send no SCAYLE Analytics events and
# keep express checkout gated; the server logs a warning at boot.
STOREFRONT_USER_CENTRICS_APP_ID=
STOREFRONT_GTM_ID=

### SECURITY HEADERS ###
# Collector for Content-Security-Policy violation reports. When unset, reports
# only reach end users' browser consoles. See https://scayle.dev/documentation/storefront/storefront-application-v3/features/platform/security-headers.
STOREFRONT_CSP_REPORT_URI=

### SUBSCRIPTION ###
# `true` turns on the subscription addon for that country. The web component
# hosts and the API URL are derived from the tenant space.
STOREFRONT_COUNTRIES_DE_SUBSCRIPTION_ENABLED=
STOREFRONT_COUNTRIES_US_SUBSCRIPTION_ENABLED=
STOREFRONT_COUNTRIES_AT_SUBSCRIPTION_ENABLED=

### SERVER ###
# Production SSR entry binds to these.
# `PORT` falls back to 3000, `HOST` to 0.0.0.0.
PORT=3000
HOST=0.0.0.0
# Strips the `x-powered-by` response header when truthy. Read at build time.
DISABLE_POWERED_BY_HEADER=

### LOCAL DEVELOPMENT ONLY ###
HTTPS_KEY=
HTTPS_CERT=
# Stands in for the `CF-IPCountry` header the country switch prompt reads. Dev mode only.
# STOREFRONT_DETECTED_COUNTRY=US
