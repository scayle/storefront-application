{
  "name": "@scayle/storefront-application-playwright",
  "private": true,
  "type": "module",
  "author": "SCAYLE Commerce Engine",
  "description": "End-to-End test suite for the SCAYLE Storefront Application.",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e:happy-path": "playwright test ./tests/happy-path.e2e.spec.ts --no-deps",
    "test:e2e": "playwright test ./tests/e2e/*.e2e.spec.ts",
    "test:e2e:a11y": "A11Y=1 playwright test --project=a11y-crawl --project=a11y-crawl-mobile",
    "a11y:summary": "node support/a11y-summary.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@orpc/client": "catalog:app",
    "@orpc/server": "catalog:app",
    "@playwright/test": "1.65.1",
    "@scayle/storefront-api": "workspace:*",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "catalog:",
    "eslint-plugin-playwright": "2.12.2",
    "globals": "^17.8.0",
    "playwright": "1.65.1",
    "playwright-core": "1.65.1",
    "playwright-testrail-reporter": "1.3.3",
    "ts-node": "10.9.2",
    "typescript": "catalog:",
    "undici-types": "8.12.4"
  }
}
