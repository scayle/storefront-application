### PLAYWRIGHT E2E ###
# Storefront URL under test, the shop's homepage: the origin and the country prefix, with a
# trailing slash (e.g. `https://localhost:3000/de/`). Specs resolve their paths against it, so it
# takes no query string or hash. Falls back to that value if unset.
BASE_URL=
# Playwright `storefrontAPIClient` builds the Storefront API host from `STOREFRONT_TENANT_SPACE` and
# authenticates with `STOREFRONT_API_KEY`, both read from the Storefront Application `.env`.
# Optional shop/country ID override. By default the shop ID is read from the page's Inertia
# `[data-page]` payload; set this only when testing an app that doesn't expose that payload.
E2E_SHOP_ID=
# Enables express checkout Playwright tests (`tests/e2e/express-checkout.e2e.spec.ts`) if set to `true`
E2E_EXPRESS_CHECKOUT_ENABLED=
# Timeout in milliseconds for one RPC request the tests send to your storefront, for example adding a
# product to the basket. Defaults to 5000. Raise it when your API answers slowly.
E2E_RPC_TIMEOUT_MS=

### PLAYWRIGHT ACCESSIBILITY CHECKS (optional) ###
# Set to `1` to scan the pages your tests visit with axe, to run the crawl (`tests/e2e/a11y-crawl.e2e.spec.ts`)
# and to turn `a11y.checkA11y` on. `pnpm test:e2e:a11y` sets it for the crawl. The crawl limits are constants
# at the top of the crawl spec.
A11Y=

### PLAYWRIGHT E2E TEST CUSTOMERS ###
# As a prerequisite to successfully run any end-to-end test that requires a signed-in customer, the following environment variables should be set:
# Dedicated test customer for Chromium in tests that are prone to conflicts (e.g. adding product to Basket in parallel for all browsers).
# This customer is also used as the default test customer across the Storefront Application end-to-end tests suite.
TEST_CUSTOMER_EMAIL1=
# Dedicated test customer for desktop Firefox.
TEST_CUSTOMER_EMAIL2=
# Dedicated test customer for desktop Webkit (Safari).
TEST_CUSTOMER_EMAIL3=
# Dedicated test customer for mobile Chrome.
TEST_CUSTOMER_EMAIL4=
# Dedicated test customer for mobile Webkit (Safari).
TEST_CUSTOMER_EMAIL5=
# Test customer used to verify hydration errors for signed-in customers on pages with items (Wishlist and Basket).
# This test customer should have items in Wishlist and Basket, so the non-empty state is tested properly.
TEST_CUSTOMER_EMAIL6=
# Test customer with no orders placed. Used to verify Orders page empty state.
TEST_CUSTOMER_NO_ORDERS=
# Password (the same for all test customers listed above).
TEST_CUSTOMER_PASSWORD=
# Deliberately incorrect password, used only in negative login tests.
TEST_CUSTOMER_WRONG_PASSWORD=
